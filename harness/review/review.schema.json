{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["context_sufficient", "summary", "findings"],
  "properties": {
    "context_sufficient": { "type": "boolean" },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "severity", "confidence", "category", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["critical", "high", "medium", "low", "nit"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "category": { "type": "string" },
          "evidence": { "type": "string" },
          "requirement": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "recommended_owner": { "enum": ["builder", "test-writer", "human"] }
        }
      }
    }
  }
}
